{
  "name": "realdentalcosts-mcp",
  "version": "0.3.1",
  "description": "Look up real US dental prices from your AI assistant: 12 procedures nationally and by state (state figures for 8), line-by-line treatment-plan checks against sourced Medicaid and cash references — data from the Real Dental Costs research index (EN/ES).",
  "type": "module",
  "license": "MIT",
  "author": "tresor4k",
  "homepage": "https://realdentalcosts.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tresor4k/realdentalcosts-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/tresor4k/realdentalcosts-mcp/issues"
  },
  "bin": {
    "realdentalcosts-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dental-costs",
    "dental-implants",
    "dental-insurance",
    "healthcare-prices",
    "price-transparency",
    "cost-of-care",
    "us-healthcare",
    "veneers",
    "braces"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/data','dist/data',{recursive:true})\"",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node test/smoke.mjs && node test/golden.mjs && node test/sources.mjs && node test/api-parity.mjs && node --test test/descriptions.test.mjs",
    "sync-data": "node scripts/sync-data.mjs",
    "start": "node dist/index.js",
    "test:http": "npm run build && node test/http-smoke.mjs",
    "package:submission": "node scripts/package-submission.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3"
  },
  "mcpName": "io.github.tresor4k/realdentalcosts-mcp"
}
