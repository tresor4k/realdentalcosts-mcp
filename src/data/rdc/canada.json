atic1.squarespace.com/static/5df9791cef94a96a9cbaafb0/t/67a1075a99564219ad24dbf2/1738606426879/DAPEI+2025+Abbreviated+Guide.pdf"}}},"NL":{"name":"Newfoundland and Labrador / Terre-Neuve-et-Labrador","fees":{"recall_exam":{"amount_cad":60.29,"min_cad":null,"max_cad":null,"is_estimate":false,"source_url":"https://www.policyme.com/dental-insurance/how-much-is-a-dental-cleaning-without-insurance"},"scaling_per_unit":{"amount_cad":76.96,"min_cad":null,"max_cad":null,"is_estimate":false,"source_url":"https://www.policyme.com/dental-insurance/how-much-is-a-dental-cleaning-without-insurance"},"filling_1surface_composite":{"amount_cad":208,"min_cad":165,"max_cad":250,"is_estimate":true,"source_url":"https://nlda.net/member/fee-guides/"},"simple_extraction":{"amount_cad":182,"min_cad":155,"max_cad":210,"is_estimate":true,"source_url":"https://nlda.net/member/fee-guides/"},"root_canal_molar":{"amount_cad":1150,"min_cad":900,"max_cad":1400,"is_estimate":true,"source_url":"https://www.hellodent.com/site/blog/2023/12/22/root-canal-cost-canada"},"complete_denture_per_arch":{"amount_cad":1200,"min_cad":900,"max_cad":1500,"is_estimate":true,"source_url":"https://voltagerewards.com/dentist/st-johns-nl/dentures"},"partial_denture_cast_metal":{"amount_cad":1300,"min_cad":1000,"max_cad":1600,"is_estimate":true,"source_url":"https://nlda.net/member/fee-guides/"},"crown_ceramic":{"amount_cad":1150,"min_cad":900,"max_cad":1400,"is_estimate":true,"source_url":"https://nlda.net/member/fee-guides/"},"single_implant_fixture_abutment_crown":{"amount_cad":4850,"min_cad":3600,"max_cad":6100,"is_estimate":true,"source_url":"https://downtowndentalcentre.com/dental-implants-costs/"}}}},"cdcp":{"recall_exam":{"matrix_row":"Examen de rappel / recall examination","covered":"yes","preauth_required":"false","rule_fr":"Couvert sans préautorisation. Fréquence : 1 examen de rappel par période de 12 mois. Maximum 3 examens toutes catégories confondues par période de 12 mois.","notes_fr":"Un examen complet (une fois tous les 60 mois) remplace l'examen de rappel pour la période d'admissibilité concernée. Les examens par des spécialistes ne comptent pas dans le maximum de 3 annuels.","source_url":"https://www.canada.ca/en/services/benefits/dental/dental-care-plan/guide.html"},"scaling_per_unit":{"matrix_row":"Détartrage / cleaning (scaling)","covered":"yes","preauth_required":"sometimes","rule_fr":"Couvert sans préautorisation jusqu'aux limites de fréquence établies. Préautorisation requise pour toute unité supplémentaire au-delà du maximum. Fréquence : 17 ans et plus = 4 unités par 12 mois (combiné avec surfaçage radiculaire) ; 12-16 ans = 1 unité par 12 mois ; 0-11 ans = 1/2 unité par 12 mois.","notes_fr":"Les unités supplémentaires au-delà du maximum requièrent une préautorisation. L'expression 'unité' correspond au système de codification SCDA (Association dentaire canadienne).","source_url":"https://www.canada.ca/en/services/benefits/dental/dental-care-plan/guide.html"},"filling_1surface_composite":{"matrix_row":"Obturation permanente / permanent filling","covered":"yes","preauth_required":"false","rule_fr":"Couvert sans préautorisation. Admissibilité : une fois par surface dentaire dans toute période de 24 mois. Combinaison de surfaces : le moindre entre le nombre total de surfaces distinctes restaurées, une restauration de 5 surfaces ou une reconstruction complète de la dent.","notes_fr":"Les amalgames liés sont couverts au taux des équivalents non liés. Quand des amalgames et des composites sont facturés pour la même dent, le RCSD paie le montant le moins élevé, jusqu'à un maximum du coût d'une restauration d'amalgame à 5 surfaces/reconstruction complète. Exclusion : restaurations pour usure incisale impliquant l'émail et la dentine.","source_url":"https://www.canada.ca/en/services/benefits/dental/dental-care-plan/guide.html"},"simple_extraction":{"matrix_row":"Extraction simple / simple (non-surgical) extraction","covered":"yes","preauth_required":"false","rule_fr":"Couvert sans préautorisation. Chirurgie buccale — extraction de dents et de racines dentaires couverte.","notes_fr":"La section chirurgie buccale couvre explicitement l'extraction de dents et de racines. Aucune limite de fréquence spécifique mentionnée pour les extractions simples dans les sources scrapées.","source_url":"https://www.canada.ca/en/services/benefits/dental/dental-care-plan/coverage.html"},"root_canal_molar":{"matrix_row":"Traitement de canal / root canal (endodontics)","covered":"yes","preauth_required":"sometimes","rule_fr":"Traitement de canal standard sur dents antérieures, prémolaires, premières et deuxièmes molaires : couvert SANS préautorisation. Préautorisation requise pour : retraitement de canal, apicectomie, obturation rétrograde, et traitement de canal sur troisièmes molaires.","notes_fr":"Le RCSD ne couvre pas le traitement de canal pour les personnes à risque élevé de caries ou ayant une maladie parodontale généralisée modérée à grave non traitée/non contrôlée.","source_url":"https://www.canada.ca/en/services/benefits/dental/dental-care-plan/guide.html"},"complete_denture_per_arch":{"matrix_row":"Prothèse complète / complete denture","covered":"yes","preauth_required":"sometimes","rule_fr":"Prothèses complètes standard : couvertes SANS préautorisation, une fois par arcade dans toute période de 96 mois (8 ans). Prothèses complètes immédiates : couvertes sans préautorisation, une fois par arcade par vie. Prothèses complètes à recouvrement (overdentures) et prothèses complètes à revêtement souple longue durée : REQUIÈRENT une préautorisation.","notes_fr":"Le RCSD ne couvre pas une nouvelle prothèse dans les 24 mois suivant un rebasage ou un regarnissage. Prothèses complètes soutenues par des implants : EXCLUSION ABSOLUE. Si une prothèse immédiate a été réclamée, d'autres prothèses complètes peuvent être demandées après 96 mois.","source_url":"https://www.canada.ca/en/services/benefits/dental/dental-care-plan/guide.html"},"partial_denture_cast_metal":{"matrix_row":"Prothèse partielle / partial denture","covered":"partial","preauth_required":"true","rule_fr":"Prothèses partielles amovibles acryliques : préautorisation requise pour le placement initial (pas pour le remplacement si la prothèse initiale a été payée par le RCSD et respecte les limites de fréquence). Fréquence : une fois par arcade dans toute période de 60 mois (5 ans) pour les prothèses acryliques, 96 mois (8 ans) pour les prothèses partielles coulées.","notes_fr":"Couverture marquée 'partial' car : (1) le placement initial requiert préautorisation ; (2) les prothèses partielles à attachements de précision sont une exclusion explicite ; (3) les prothèses partielles soutenues par des implants sont exclues.","source_url":"https://www.canada.ca/en/services/benefits/dental/dental-care-plan/guide.html"},"crown_ceramic":{"matrix_row":"Couronne / crown","covered":"partial","preauth_required":"true","rule_fr":"Couverture conditionnelle avec préautorisation obligatoire. Types couverts : coulée en métal, porcelaine/céramique sur métal, porcelaine/céramique. Fréquence : 4 couronnes dans toute période de 120 mois (10 ans) par patient ; 1 couronne dans toute période de 96 mois (8 ans) par dent admissible. Remboursement pour couronnes non posées (non-inserted) : jusqu'à 20 % des honoraires RCSD en vigueur.","notes_fr":"Couverture marquée 'partial' car : (1) préautorisation obligatoire ; (2) toutes les couronnes sur implant sont une exclusion absolue et non eligible à reconsidération ; (3) toutes les 3/4 couronnes sont exclues ; (4) conditions cliniques strictes (maladie active traitée au préalable, etc.). Pour les couronnes non posées : remboursement jusqu'à 20 % des honoraires RCSD + frais de laboratoire raisonnables, sous conditions.","source_url":"https://www.canada.ca/en/services/benefits/dental/dental-care-plan/guide.html"},"single_implant_fixture_abutment_crown":{"matrix_row":"Implant dentaire / dental implant","covered":"no","preauth_required":"false","rule_fr":"EXCLUSION ABSOLUE. Les implants et toutes les procédures liées aux implants sont des exclusions explicites du RCSD, non éligibles à une reconsidération.","notes_fr":"Verbatim du guide : 'Implants and ridge augmentation are exclusions under the CDCP.' / 'implants and all implant-related procedures' listés dans l'Annexe E (exclusions). Les greffes osseuses (bone grafts) sont également exclues.","source_url":"https://www.canada.ca/en/services/benefits/dental/dental-care-plan/guide.html"}},"tiers":[{"id":"u70","band_en":"Under $70,000","band_fr":"Moins de 70 000 $","lower_bound_cad":0,"cdcp_share_pct":100,"copay_pct":0},{"id":"70_80","band_en":"$70,000–$79,999","band_fr":"70 000 $ – 79 999 $","lower_bound_cad":70000,"cdcp_share_pct":60,"copay_pct":40},{"id":"80_90","band_en":"$80,000–$89,999","band_fr":"80 000 $ – 89 999 $","lower_bound_cad":80000,"cdcp_share_pct":40,"copay_pct":60},{"id":"o90","band_en":"$90,000 and above","band_fr":"90 000 $ et plus","lower_bound_cad":90000,"cdcp_share_pct":0,"copay_pct":100}],"tiers_source":{"source":"Government of Canada, Canadian Dental Care Plan coverage page (co-payment by adjusted family net income)","source_url":"https://www.canada.ca/en/services/benefits/dental/dental-care-plan/coverage.html","period":"2026"},"dataset":{"doi_url":"https://doi.org/10.5281/zenodo.20744781","csv_url":"https://realdentalcosts.com/data/canada-dental-cost-index-by-province-2026.csv","cdcp_csv_url":"https://realdentalcosts.com/data/cdcp-coverage-matrix-2026.csv","audited_at":"2026-06-18"}}